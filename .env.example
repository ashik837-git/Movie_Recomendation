# ==============================================================================
# CinePulse Environment Configuration Template
# Copy this file to .env in backend/ and frontend/ and replace placeholders.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# --- Backend Configuration ---
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://cinepulse.vercel.app
ARTIFACTS_DIR=backend/app/recommender/artifacts

# --- Supabase (Auth & Database) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# --- TMDB Artwork & Video Trailer API (Optional) ---
# TMDB API Read Access Token or v3 API Key for fetching official posters/trailers.
# Note: CinePulse operates seamlessly with gradient fallback posters if empty.
TMDB_API_KEY=your-tmdb-api-key-optional

# --- Payment & Subscription Provider ---
# Supported providers: sandbox, stripe, sslcommerz
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_PREMIUM=price_placeholder_premium
STRIPE_PRICE_PRO=price_placeholder_pro

# --- Frontend Public Variables ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
